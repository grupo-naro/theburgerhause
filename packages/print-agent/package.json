{
  "name": "@burgerhause/print-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Print agent for The Burger Hause: SSE client that prints server-rendered tickets as ESC/POS on a local thermal printer.",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "bin": { "print-agent": "dist/print-agent.cjs" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/print-agent",
    "lint": "pnpm -w exec eslint packages/print-agent"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5"
  }
}
