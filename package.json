{
  "name": "theburgerhause",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.mts",
    "test:deploy": "bash deploy/tests/run-all.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-admin": "tsx src/db/seed-admin.ts",
    "db:init-prod": "tsx src/db/init-prod.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:up": "docker compose up -d",
    "verify:fast": "pnpm lint && pnpm test && pnpm --filter @burgerhause/print-agent typecheck && pnpm build",
    "verify": "pnpm lint && pnpm test && pnpm --filter @burgerhause/print-agent typecheck && pnpm test:int && pnpm build && pnpm e2e && git status --porcelain"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.10.0"
}
