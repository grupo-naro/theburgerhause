# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# subagent-driven-development scratch
/.superpowers/

# uploaded images (local dev)
/.uploads/

# playwright e2e
/test-results/
/playwright-report/
/e2e/.auth/
