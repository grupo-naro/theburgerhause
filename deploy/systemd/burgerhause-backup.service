# Daily backup job (database dump + uploads copy [+ remote copy]). Started by burgerhause-backup.timer.
# Install as /etc/systemd/system/burgerhause-backup.service. Run it by hand: systemctl start burgerhause-backup
# Result:  systemctl status burgerhause-backup   |   journalctl -u burgerhause-backup -n 50
[Unit]
Description=The Burger Hause - database and uploads backup
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=burgerhause
Group=burgerhause
# DATABASE_URL, UPLOAD_DIR and the optional BACKUP_REMOTE / BACKUP_SSH_KEY come from here.
EnvironmentFile=/etc/burgerhause/burgerhause.env
# Dump over the UNIX socket with peer authentication as User=burgerhause (the Postgres role has the same name):
# no password ever reaches a command line. DATABASE_URL (with its password) stays in the environment only.
Environment=BACKUP_DB=burgerhause
# ssh looks for ~/.ssh/known_hosts and the key here (see the runbook, "copiar los backups fuera de la VPS").
Environment=HOME=/var/lib/burgerhause
ExecStart=/opt/burgerhause/current/deploy/scripts/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=burgerhause-backup
TimeoutStartSec=1h

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/burgerhause
ReadOnlyPaths=/var/lib/burgerhause
