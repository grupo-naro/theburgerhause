# The Burger Hause - production environment file (TEMPLATE, contains NO real secrets).
# On the server: /etc/burgerhause/burgerhause.env   owner root:burgerhause   mode 0640
#   install -d -m 0750 -o root -g burgerhause /etc/burgerhause
#   install -m 0640 -o root -g burgerhause deploy/env/burgerhause.env.example /etc/burgerhause/burgerhause.env
# systemd reads it as KEY=value lines: NO quotes, NO `export`, NO spaces around `=`.
# Every value marked CHANGE_ME must be replaced by the operator.

# ---- required --------------------------------------------------------------------------------------
# PostgreSQL on the same machine (127.0.0.1, port 5432 is NOT exposed to the internet).
# If the password has special characters (@ : / ? # %), URL-encode them (or use only letters and digits).
DATABASE_URL=postgres://burgerhause:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/burgerhause

# At least 32 random bytes. Generate:  openssl rand -base64 48
# Changing it logs everybody out (sessions are signed with it).
SESSION_SECRET=CHANGE_ME_openssl_rand_base64_48

# Absolute path, owned by the app user, readable by nginx's group.
UPLOAD_DIR=/var/lib/burgerhause/uploads

NODE_ENV=production

# ---- NOT in this file, on purpose --------------------------------------------------------------------
# * The admin password: created once with `ADMIN_USERNAME=... ADMIN_PASSWORD=... pnpm db:seed-admin`.
# * The print station tokens: generated in the admin panel (Estaciones), shown once.
# * ALLOW_DEMO_SEED must NEVER be set in production.

# ---- optional: read by deploy/scripts/*.sh (the app itself ignores them) ------------------------------------
# Where deploy.sh fetches the code from (a read-only deploy key must be installed for root) and which branch/tag.
# REPO_URL=git@github.com:OWNER/REPO.git
# REF=main
# Off-site copy of the daily backup (rsync over ssh). See docs/ops/runbook.md, "Copiar los backups fuera de la VPS".
# BACKUP_REMOTE=backupuser@backup-host.example.com:/srv/backups/burgerhause
# BACKUP_SSH_KEY=/var/lib/burgerhause/.ssh/backup_ed25519
